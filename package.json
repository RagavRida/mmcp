{
  "name": "@mmcp/core",
  "version": "1.1.0",
  "description": "Multiple Model Context Protocol — orchestrate AI models as a coordinated DAG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "Raghavendra Machikatla",
  "repository": {
    "type": "git",
    "url": "https://github.com/RagavRida/mmcp.git"
  },
  "homepage": "https://github.com/RagavRida/mmcp#readme",
  "bugs": {
    "url": "https://github.com/RagavRida/mmcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/",
    "lint": "tsc --noEmit",
    "example:specialization": "ts-node examples/specialization.ts",
    "example:parallel": "ts-node examples/parallel.ts",
    "example:verify": "ts-node examples/verify.ts",
    "example:openrouter": "ts-node -r dotenv/config examples/openrouter.ts",
    "example:cross-vendor": "ts-node -r dotenv/config examples/cross_vendor.ts",
    "example:legal-review": "ts-node -r dotenv/config examples/legal_review.ts",
    "example:showcase": "ts-node -r dotenv/config examples/showcase.ts",
    "example:shared-context": "ts-node -r dotenv/config examples/shared_context.ts",
    "example:skills-demo": "ts-node -r dotenv/config examples/skills_demo.ts",
    "example:v1-demo": "ts-node -r dotenv/config examples/v1_demo.ts"
  },
  "keywords": [
    "mmcp",
    "multi-agent",
    "llm",
    "orchestration",
    "dag",
    "context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "dotenv": "^17.3.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}