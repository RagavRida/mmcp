{
  "name": "mmcp-core",
  "version": "2.2.0",
  "description": "MMCP — Multi-Model Context Protocol. Intelligent AI model routing with MCP server for Claude Desktop & Codex CLI. Auto-routes tasks to Claude, GPT, Gemini, DeepSeek, Llama with RL-based smart routing and cost optimization.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mmcp-core": "./bin/mmcp-mcp-server.js"
  },
  "files": [
    "dist/",
    "bin/",
    "python/mmcp_core/",
    "python/mmcp_mcp_server/",
    "python/pyproject.toml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "PROTOCOL_SPEC.md"
  ],
  "author": "Raghavendra Machikatla",
  "repository": {
    "type": "git",
    "url": "https://github.com/RagavRida/mmcp.git"
  },
  "homepage": "https://github.com/RagavRida/mmcp#readme",
  "bugs": {
    "url": "https://github.com/RagavRida/mmcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/",
    "lint": "tsc --noEmit",
    "example:specialization": "ts-node examples/specialization.ts",
    "example:parallel": "ts-node examples/parallel.ts",
    "example:verify": "ts-node examples/verify.ts",
    "example:openrouter": "ts-node -r dotenv/config examples/openrouter.ts",
    "example:cross-vendor": "ts-node -r dotenv/config examples/cross_vendor.ts",
    "example:legal-review": "ts-node -r dotenv/config examples/legal_review.ts",
    "example:showcase": "ts-node -r dotenv/config examples/showcase.ts",
    "example:shared-context": "ts-node -r dotenv/config examples/shared_context.ts",
    "example:skills-demo": "ts-node -r dotenv/config examples/skills_demo.ts",
    "example:v1-demo": "ts-node -r dotenv/config examples/v1_demo.ts"
  },
  "keywords": [
    "mmcp",
    "multi-agent",
    "llm",
    "orchestration",
    "dag",
    "context-protocol",
    "ai-agents",
    "multi-model",
    "reinforcement-learning",
    "pipeline",
    "agent-mesh",
    "protocol",
    "model-routing",
    "ai-orchestration",
    "langchain-alternative",
    "crewai-alternative",
    "autogen-alternative",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-desktop",
    "codex",
    "cursor",
    "claude-code",
    "windsurf",
    "copilot",
    "ai-ide",
    "openai",
    "anthropic",
    "gemini",
    "smart-routing",
    "cost-optimization"
  ],
  "license": "MIT",
  "dependencies": {
    "mmcp-seo-geo-skill": "^1.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "dotenv": "^17.3.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
